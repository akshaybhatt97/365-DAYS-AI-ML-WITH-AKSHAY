        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.datasets import fetch_california_housing\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import Ridge\n",
        "from sklearn.metrics import (\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 1. Load real California Housing dataset\n",
        "# --------------------------------------------------\n",
        "\n",
        "housing = fetch_california_housing(as_frame=True)\n",
        "\n",
        "X = housing.data\n",
        "y = housing.target\n",
        "\n",
        "print(\"Dataset shape:\", X.shape)\n",
        "print(\"\\nFeatures:\")\n",
        "print(X.columns.tolist())\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 2. Train / test split\n",
        "# --------------------------------------------------\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 3. Standardize features\n",
        "# --------------------------------------------------\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 4. Try different regularization strengths\n",
        "# --------------------------------------------------\n",
        "\n",
        "alphas = [\n",
        "    0.01,\n",
        "    0.1,\n",
        "    1,\n",
        "    10,\n",
        "    100,\n",
        "    1000\n",
        "]\n",
        "\n",
        "rmse_values = []\n",
        "r2_values = []\n",
        "coefficient_sizes = []\n",
        "\n",
        "all_coefficients = []\n",
        "\n",
        "\n",
        "for alpha in alphas:\n",
        "\n",
        "    model = Ridge(\n",
        "        alpha=alpha\n",
        "    )\n",
        "\n",
        "    model.fit(\n",
        "        X_train_scaled,\n",
        "        y_train\n",
        "    )\n",
        "\n",
        "    predictions = model.predict(\n",
        "        X_test_scaled\n",
        "    )\n",
        "\n",
        "    mse = mean_squared_error(\n",
        "        y_test,\n",
        "        predictions\n",
        "    )\n",
        "\n",
        "    rmse = np.sqrt(mse)\n",
        "\n",
        "    r2 = r2_score(\n",
        "        y_test,\n",
        "        predictions\n",
        "    )\n",
        "\n",
        "    # Overall coefficient magnitude\n",
        "    coefficient_size = np.linalg.norm(\n",
        "        model.coef_\n",
        "    )\n",
        "\n",
        "    rmse_values.append(rmse)\n",
        "    r2_values.append(r2)\n",
        "    coefficient_sizes.append(\n",
        "        coefficient_size\n",
        "    )\n",
        "\n",
        "    all_coefficients.append(\n",
        "        model.coef_\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Alpha = {alpha}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"RMSE:\",\n",
        "        round(rmse, 4)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"R²:\",\n",
        "        round(r2, 4)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Coefficient magnitude:\",\n",
        "        round(coefficient_size, 4)\n",
        "    )\n",
        "\n",
        "    print()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 5. Results table\n",
        "# --------------------------------------------------\n",
        "\n",
        "results = pd.DataFrame({\n",
        "    \"Alpha\": alphas,\n",
        "    \"RMSE\": rmse_values,\n",
        "    \"R2\": r2_values,\n",
        "    \"Coefficient Magnitude\": coefficient_sizes\n",
        "})\n",
        "\n",
        "print(\"\\nRESULTS\")\n",
        "print(results.round(4))\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 6. Visual 1:\n",
        "# Alpha vs coefficient magnitude\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    alphas,\n",
        "    coefficient_sizes,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xscale(\"log\")\n",
        "\n",
        "plt.xlabel(\"Alpha\")\n",
        "plt.ylabel(\"Overall Coefficient Magnitude\")\n",
        "\n",
        "plt.title(\n",
        "    \"Ridge Regression: Increasing Alpha Shrinks Coefficients\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 7. Visual 2:\n",
        "# Alpha vs test RMSE\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    alphas,\n",
        "    rmse_values,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xscale(\"log\")\n",
        "\n",
        "plt.xlabel(\"Alpha\")\n",
        "plt.ylabel(\"Test RMSE\")\n",
        "\n",
        "plt.title(\n",
        "    \"Ridge Regression: Regularization Strength vs Test Error\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# 8. Visual 3:\n",
        "# See how individual coefficients shrink\n",
        "# --------------------------------------------------\n",
        "\n",
        "all_coefficients = np.array(\n",
        "    all_coefficients\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "for i, feature in enumerate(X.columns):\n",
        "\n",
        "    plt.plot(\n",
        "        alphas,\n",
        "        all_coefficients[:, i],\n",
        "        marker=\"o\",\n",
        "        label=feature\n",
        "    )\n",
        "\n",
        "plt.xscale(\"log\")\n",
        "\n",
        "plt.xlabel(\"Alpha\")\n",
        "plt.ylabel(\"Coefficient\")\n",
        "\n",
        "plt.title(\n",
        "    \"How Ridge Shrinks Feature Coefficients\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
