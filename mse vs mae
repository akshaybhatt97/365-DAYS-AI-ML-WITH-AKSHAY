{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\n\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error\n\nactual = np.array([50, 60, 70, 80, 90])\n\n# Scenario A: all predictions are close\npred_a = np.array([48, 63, 68, 78, 88])\n\n# Scenario B: same predictions, but one big mistake\npred_b = np.array([48, 63, 68, 78, 110])\n\n\ndef calculate_metrics(actual, predicted):\n    mae = mean_absolute_error(actual, predicted)\n    mse = mean_squared_error(actual, predicted)\n    rmse = np.sqrt(mse)\n\n    return mae, mse, rmse\n\n\nmae_a, mse_a, rmse_a = calculate_metrics(actual, pred_a)\nmae_b, mse_b, rmse_b = calculate_metrics(actual, pred_b)\n\nprint(\"Scenario A\")\nprint(\"MAE :\", round(mae_a, 2))\nprint(\"MSE :\", round(mse_a, 2))\nprint(\"RMSE:\", round(rmse_a, 2))\n\nprint(\"\\nScenario B\")\nprint(\"MAE :\", round(mae_b, 2))\nprint(\"MSE :\", round(mse_b, 2))\nprint(\"RMSE:\", round(rmse_b, 2))\n\n\n# -----------------------------\n# Plot 1: MAE and RMSE\n# -----------------------------\n\nlabels = [\"MAE\", \"RMSE\"]\n\nscenario_a_original_units = [mae_a, rmse_a]\nscenario_b_original_units = [mae_b, rmse_b]\n\nx = np.arange(len(labels))\nwidth = 0.35\n\nplt.figure(figsize=(8, 5))\n\nplt.bar(\n    x - width / 2,\n    scenario_a_original_units,\n    width,\n    label=\"Scenario A\"\n)\n\nplt.bar(\n    x + width / 2,\n    scenario_b_original_units,\n    width,\n    label=\"Scenario B\"\n)\n\nplt.xticks(x, labels)\nplt.ylabel(\"Error (₹ lakh)\")\nplt.title(\"MAE vs RMSE: Effect of One Large Error\")\nplt.legend()\n\nplt.show()\n\n\n# -----------------------------\n# Plot 2: MSE separately\n# -----------------------------\n\nplt.figure(figsize=(6, 5))\n\nplt.bar(\n    [\"Scenario A\", \"Scenario B\"],\n    [mse_a, mse_b]\n)\n\nplt.ylabel(\"Squared Error\")\nplt.title(\"MSE: Effect of One Large Error\")\n\nplt.show()","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-10T16:15:06.330627Z","iopub.execute_input":"2026-08-10T16:15:06.331689Z","iopub.status.idle":"2026-08-10T16:15:06.593122Z","shell.execute_reply.started":"2026-08-10T16:15:06.331647Z","shell.execute_reply":"2026-08-10T16:15:06.592083Z"}},"outputs":[{"name":"stdout","text":"Scenario A\nMAE : 2.2\nMSE : 5.0\nRMSE: 2.24\n\nScenario B\nMAE : 5.8\nMSE : 84.2\nRMSE: 9.18\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":2}]}