{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\n\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_squared_error\n\nnp.random.seed(42)\n\n# -----------------------------------\n# 1. Create synthetic housing data\n# -----------------------------------\n\nn = 120\n\narea = np.random.uniform(600, 2500, n)\nbedrooms = np.random.randint(1, 6, n)\nage = np.random.randint(0, 40, n)\n\n# House price depends on these\nprice = (\n    15\n    + 0.04 * area\n    + 4 * bedrooms\n    - 0.5 * age\n    + np.random.normal(0, 7, n)\n)\n\n# -----------------------------------\n# 2. Relevant features\n# -----------------------------------\n\nX_relevant = np.column_stack([\n    area,\n    bedrooms,\n    age\n])\n\n# -----------------------------------\n# 3. Add meaningless noise features\n# -----------------------------------\n\nnoise_features = np.random.normal(\n    0,\n    1,\n    size=(n, 40)\n)\n\nX_complex = np.column_stack([\n    X_relevant,\n    noise_features\n])\n\n# Use same train/test indices\nindices = np.arange(n)\n\ntrain_idx, test_idx = train_test_split(\n    indices,\n    test_size=0.35,\n    random_state=42\n)\n\n# -----------------------------------\n# Model A: Area only\n# -----------------------------------\n\nX_area = area.reshape(-1, 1)\n\nmodel_a = LinearRegression()\n\nmodel_a.fit(\n    X_area[train_idx],\n    price[train_idx]\n)\n\ntrain_pred_a = model_a.predict(\n    X_area[train_idx]\n)\n\ntest_pred_a = model_a.predict(\n    X_area[test_idx]\n)\n\n# -----------------------------------\n# Model B: Relevant features\n# -----------------------------------\n\nmodel_b = LinearRegression()\n\nmodel_b.fit(\n    X_relevant[train_idx],\n    price[train_idx]\n)\n\ntrain_pred_b = model_b.predict(\n    X_relevant[train_idx]\n)\n\ntest_pred_b = model_b.predict(\n    X_relevant[test_idx]\n)\n\n# -----------------------------------\n# Model C: Relevant + noise features\n# -----------------------------------\n\nmodel_c = LinearRegression()\n\nmodel_c.fit(\n    X_complex[train_idx],\n    price[train_idx]\n)\n\ntrain_pred_c = model_c.predict(\n    X_complex[train_idx]\n)\n\ntest_pred_c = model_c.predict(\n    X_complex[test_idx]\n)\n\n# -----------------------------------\n# Calculate MSE\n# -----------------------------------\n\nmodels = [\n    \"Area Only\",\n    \"Relevant Features\",\n    \"Relevant + Noise\"\n]\n\ntrain_mse = [\n    mean_squared_error(\n        price[train_idx],\n        train_pred_a\n    ),\n    mean_squared_error(\n        price[train_idx],\n        train_pred_b\n    ),\n    mean_squared_error(\n        price[train_idx],\n        train_pred_c\n    )\n]\n\ntest_mse = [\n    mean_squared_error(\n        price[test_idx],\n        test_pred_a\n    ),\n    mean_squared_error(\n        price[test_idx],\n        test_pred_b\n    ),\n    mean_squared_error(\n        price[test_idx],\n        test_pred_c\n    )\n]\n\nfor name, train, test in zip(\n    models,\n    train_mse,\n    test_mse\n):\n    print(name)\n    print(\"Train MSE:\", round(train, 2))\n    print(\"Test MSE :\", round(test, 2))\n    print()\n\n# -----------------------------------\n# Visual\n# -----------------------------------\n\nx = np.arange(len(models))\nwidth = 0.35\n\nplt.figure(figsize=(9, 5))\n\nplt.bar(\n    x - width / 2,\n    train_mse,\n    width,\n    label=\"Training MSE\"\n)\n\nplt.bar(\n    x + width / 2,\n    test_mse,\n    width,\n    label=\"Test MSE\"\n)\n\nplt.xticks(\n    x,\n    models\n)\n\nplt.ylabel(\"Mean Squared Error\")\n\nplt.title(\n    \"Underfitting vs Good Fit vs Overfitting\"\n)\n\nplt.legend()\nplt.tight_layout()\n\nplt.show()","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-19T17:41:29.865474Z","iopub.execute_input":"2026-08-19T17:41:29.865765Z","iopub.status.idle":"2026-08-19T17:41:33.721391Z","shell.execute_reply.started":"2026-08-19T17:41:29.865738Z","shell.execute_reply":"2026-08-19T17:41:33.720181Z"}},"outputs":[{"name":"stdout","text":"Area Only\nTrain MSE: 82.36\nTest MSE : 140.29\n\nRelevant Features\nTrain MSE: 30.76\nTest MSE : 52.53\n\nRelevant + Noise\nTrain MSE: 16.26\nTest MSE : 94.45\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 900x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":1}]}