{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\n\n# --------------------------------------------------\n# 1. Simple house-price dataset\n# --------------------------------------------------\n\n# House area in 1000 sq ft\nX = np.array([0.5, 1.0, 1.5, 2.0, 2.5])\n\n# House prices in lakh\ny = np.array([30, 50, 72, 88, 112])\n\n\n# --------------------------------------------------\n# 2. Model form\n# Prediction = weight * X + bias\n# --------------------------------------------------\n\nbias = 10\n\n# Try many possible weights\nweights = np.linspace(10, 60, 200)\n\n# Regularization strength\nlambda_value = 0.02\n\nmse_values = []\nregularized_loss_values = []\n\n\n# --------------------------------------------------\n# 3. Test every possible weight\n# --------------------------------------------------\n\nfor weight in weights:\n\n    # Predictions\n    predictions = weight * X + bias\n\n    # Mean Squared Error\n    mse = np.mean(\n        (y - predictions) ** 2\n    )\n\n    # L2-style penalty\n    penalty = (\n        lambda_value\n        * weight ** 2\n    )\n\n    # Regularized loss\n    regularized_loss = (\n        mse + penalty\n    )\n\n    mse_values.append(mse)\n    regularized_loss_values.append(\n        regularized_loss\n    )\n\n\nmse_values = np.array(mse_values)\n\nregularized_loss_values = np.array(\n    regularized_loss_values\n)\n\n\n# --------------------------------------------------\n# 4. Find best weight WITHOUT regularization\n# --------------------------------------------------\n\nbest_mse_index = np.argmin(\n    mse_values\n)\n\nbest_mse_weight = weights[\n    best_mse_index\n]\n\n\n# --------------------------------------------------\n# 5. Find best weight WITH regularization\n# --------------------------------------------------\n\nbest_reg_index = np.argmin(\n    regularized_loss_values\n)\n\nbest_reg_weight = weights[\n    best_reg_index\n]\n\n\nprint(\n    \"Best weight using only MSE:\",\n    round(best_mse_weight, 2)\n)\n\nprint(\n    \"Best weight with regularization:\",\n    round(best_reg_weight, 2)\n)\n\n\n# --------------------------------------------------\n# 6. Visual 1\n# MSE vs Regularized Loss\n# --------------------------------------------------\n\nplt.figure(figsize=(9, 5))\n\nplt.plot(\n    weights,\n    mse_values,\n    label=\"MSE only\"\n)\n\nplt.plot(\n    weights,\n    regularized_loss_values,\n    label=\"MSE + Regularization Penalty\"\n)\n\nplt.axvline(\n    best_mse_weight,\n    linestyle=\"--\",\n    label=f\"Best MSE weight = {best_mse_weight:.2f}\"\n)\n\nplt.axvline(\n    best_reg_weight,\n    linestyle=\":\",\n    label=f\"Best regularized weight = {best_reg_weight:.2f}\"\n)\n\nplt.xlabel(\"Model Weight\")\nplt.ylabel(\"Loss\")\n\nplt.title(\n    \"How Regularization Changes the Best Model Weight\"\n)\n\nplt.legend()\nplt.tight_layout()\nplt.show()\n\n\n# --------------------------------------------------\n# 7. Compare final prediction lines\n# --------------------------------------------------\n\nnormal_predictions = (\n    best_mse_weight * X\n    + bias\n)\n\nregularized_predictions = (\n    best_reg_weight * X\n    + bias\n)\n\nplt.figure(figsize=(9, 5))\n\nplt.scatter(\n    X,\n    y,\n    s=80,\n    label=\"Actual House Prices\"\n)\n\nplt.plot(\n    X,\n    normal_predictions,\n    marker=\"o\",\n    label=\"Model using MSE only\"\n)\n\nplt.plot(\n    X,\n    regularized_predictions,\n    marker=\"o\",\n    label=\"Regularized Model\"\n)\n\nplt.xlabel(\n    \"House Area (1000 sq ft)\"\n)\n\nplt.ylabel(\n    \"House Price (₹ lakh)\"\n)\n\nplt.title(\n    \"Prediction Line: With vs Without Regularization\"\n)\n\nplt.legend()\nplt.tight_layout()\nplt.show()","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-23T13:41:46.672743Z","iopub.execute_input":"2026-08-23T13:41:46.673041Z","iopub.status.idle":"2026-08-23T13:41:47.265122Z","shell.execute_reply.started":"2026-08-23T13:41:46.673013Z","shell.execute_reply":"2026-08-23T13:41:47.264346Z"}},"outputs":[{"name":"stdout","text":"Best weight using only MSE: 40.4\nBest weight with regularization: 39.9\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 900x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 900x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":1}]}