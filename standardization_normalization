{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom sklearn.preprocessing import StandardScaler, MinMaxScaler\n\n\n# --------------------------------------------------\n# 1. Create a small customer dataset\n# --------------------------------------------------\n\ndata = pd.DataFrame({\n    \"Age\": [25, 32, 40, 48, 55],\n\n    \"Annual_Income\": [\n        30000,\n        50000,\n        80000,\n        120000,\n        160000\n    ],\n\n    \"Credit_Utilization\": [\n        0.20,\n        0.35,\n        0.55,\n        0.72,\n        0.90\n    ]\n})\n\nprint(\"\\nORIGINAL DATA\")\nprint(data)\n\n\n# --------------------------------------------------\n# 2. STANDARDIZATION\n# --------------------------------------------------\n\nstandard_scaler = StandardScaler()\n\nstandardized = standard_scaler.fit_transform(data)\n\nstandardized_df = pd.DataFrame(\n    standardized,\n    columns=data.columns\n)\n\nprint(\"\\nSTANDARDIZED DATA\")\nprint(standardized_df.round(2))\n\n\n# --------------------------------------------------\n# 3. NORMALIZATION / MIN-MAX SCALING\n# --------------------------------------------------\n\nminmax_scaler = MinMaxScaler()\n\nnormalized = minmax_scaler.fit_transform(data)\n\nnormalized_df = pd.DataFrame(\n    normalized,\n    columns=data.columns\n)\n\nprint(\"\\nNORMALIZED DATA\")\nprint(normalized_df.round(2))\n\n\n# --------------------------------------------------\n# 4. Verify Standardization\n# --------------------------------------------------\n\nprint(\"\\nSTANDARDIZATION CHECK\")\n\nprint(\"\\nMean:\")\nprint(\n    standardized_df.mean().round(2)\n)\n\nprint(\"\\nStandard Deviation:\")\nprint(\n    standardized_df.std(ddof=0).round(2)\n)\n\n\n# --------------------------------------------------\n# 5. Verify Min-Max Normalization\n# --------------------------------------------------\n\nprint(\"\\nNORMALIZATION CHECK\")\n\nprint(\"\\nMinimum:\")\nprint(\n    normalized_df.min().round(2)\n)\n\nprint(\"\\nMaximum:\")\nprint(\n    normalized_df.max().round(2)\n)\n\n\n# --------------------------------------------------\n# 6. Visual 1: Original Data\n# --------------------------------------------------\n\ndata.plot(\n    kind=\"bar\",\n    figsize=(9, 5)\n)\n\nplt.title(\n    \"Before Feature Scaling\"\n)\n\nplt.xlabel(\"Customer\")\nplt.ylabel(\"Original Value\")\n\nplt.tight_layout()\nplt.show()\n\n\n# --------------------------------------------------\n# 7. Visual 2: Standardized Data\n# --------------------------------------------------\n\nstandardized_df.plot(\n    kind=\"bar\",\n    figsize=(9, 5)\n)\n\nplt.axhline(\n    0,\n    linestyle=\"--\"\n)\n\nplt.title(\n    \"After Standardization\"\n)\n\nplt.xlabel(\"Customer\")\nplt.ylabel(\"Standardized Value\")\n\nplt.tight_layout()\nplt.show()\n\n\n# --------------------------------------------------\n# 8. Visual 3: Normalized Data\n# --------------------------------------------------\n\nnormalized_df.plot(\n    kind=\"bar\",\n    figsize=(9, 5)\n)\n\nplt.title(\n    \"After Min-Max Normalization\"\n)\n\nplt.xlabel(\"Customer\")\nplt.ylabel(\"Normalized Value\")\n\nplt.ylim(\n    0,\n    1.05\n)\n\nplt.tight_layout()\nplt.show()\n\n\n# --------------------------------------------------\n# 9. Small manual Min-Max example\n# --------------------------------------------------\n\nincome = 80000\n\nincome_min = data[\"Annual_Income\"].min()\nincome_max = data[\"Annual_Income\"].max()\n\nscaled_income = (\n    (income - income_min)\n    /\n    (income_max - income_min)\n)\n\nprint(\"\\nMANUAL MIN-MAX CALCULATION\")\n\nprint(\n    f\"₹{income:,} becomes:\",\n    round(scaled_income, 2)\n)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-22T14:32:06.319178Z","iopub.execute_input":"2026-08-22T14:32:06.319576Z","iopub.status.idle":"2026-08-22T14:32:07.064272Z","shell.execute_reply.started":"2026-08-22T14:32:06.319541Z","shell.execute_reply":"2026-08-22T14:32:07.063415Z"}},"outputs":[{"name":"stdout","text":"\nORIGINAL DATA\n   Age  Annual_Income  Credit_Utilization\n0   25          30000                0.20\n1   32          50000                0.35\n2   40          80000                0.55\n3   48         120000                0.72\n4   55         160000                0.90\n\nSTANDARDIZED DATA\n    Age  Annual_Income  Credit_Utilization\n0 -1.40          -1.23               -1.37\n1 -0.74          -0.81               -0.77\n2  0.00          -0.17                0.02\n3  0.74           0.68                0.70\n4  1.40           1.53                1.42\n\nNORMALIZED DATA\n    Age  Annual_Income  Credit_Utilization\n0  0.00           0.00                0.00\n1  0.23           0.15                0.21\n2  0.50           0.38                0.50\n3  0.77           0.69                0.74\n4  1.00           1.00                1.00\n\nSTANDARDIZATION CHECK\n\nMean:\nAge                  -0.0\nAnnual_Income        -0.0\nCredit_Utilization   -0.0\ndtype: float64\n\nStandard Deviation:\nAge                   1.0\nAnnual_Income         1.0\nCredit_Utilization    1.0\ndtype: float64\n\nNORMALIZATION CHECK\n\nMinimum:\nAge                   0.0\nAnnual_Income         0.0\nCredit_Utilization    0.0\ndtype: float64\n\nMaximum:\nAge                   1.0\nAnnual_Income         1.0\nCredit_Utilization    1.0\ndtype: float64\n","output_type":"stream"},{"output_type":"display_data","data":{"text/p